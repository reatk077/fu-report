{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/data.js": { "maxDuration": 60 },
    "api/refresh.js": { "maxDuration": 60 },
    "api/health.js": { "maxDuration": 30 }
  },
  "headers": [
    { "source": "/api/(.*)", "headers": [ { "key": "Cache-Control", "value": "no-store" } ] }
  ]
}
