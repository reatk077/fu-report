# ===== 数据与分析（无需密钥，免费公开源）=====
# 下面这些是可选的运行参数（不填用默认值，默认即可工作）

# ===== AI 综合解读与预判（OpenAI 兼容）=====
# 留空时页面/CLI 回退到"规则模板"文字解读（仍可用，只是没有 AI 的完整点评）
# 在 Vercel 里通过 Environment Variables 配置（不要提交到仓库）
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# 是否在分析中启用霍尔木兹风险情报（1=开，0=关；默认1）
ENABLE_EVENTS=1
